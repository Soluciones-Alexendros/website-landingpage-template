{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 7am"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "semanticCommits": "enabled",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": ["npm", "github-actions"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"],
    "automerge": true,
    "automergeType": "pr"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Automerge patch/minor/pin/digest solo de devDependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "npm development (non-major)",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Producción: PR de revisión, sin automerge",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "npm production (non-major)",
      "automerge": false
    },
    {
      "description": "GitHub Actions no-major: revisión humana",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions",
      "automerge": false
    },
    {
      "description": "Majors: aprobación en Dependency Dashboard, sin automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "breaking-change"]
    }
  ]
}
